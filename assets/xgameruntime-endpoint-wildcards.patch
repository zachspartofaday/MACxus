+/* Error bodies are untrusted. Retain only an optional bounded numeric XErr,
+ * never request/response text, tokens, identities or redirect URLs. Diagnostic
+ * parsing must not change the original authorization failure. */
+static BOOL xsts_error_code( const BYTE *buffer, SIZE_T size, DWORD *code )
+{
+    static const WCHAR *class_name = RuntimeClass_Windows_Data_Json_JsonValue;
+    IJsonValueStatics *statics = NULL;
+    IJsonObject *object = NULL;
+    IJsonValue *value = NULL;
+    HSTRING_HEADER header;
+    HSTRING class_id, text = NULL;
+    WCHAR *wide = NULL;
+    DOUBLE number;
+    int length;
+    HRESULT com;
+    BOOL valid = FALSE;
+
+    *code = 0;
+    if (!buffer || !size || size > 16384) return FALSE;
+    com = CoInitializeEx( NULL, COINIT_MULTITHREADED );
+    if (FAILED(com) && com != RPC_E_CHANGED_MODE) goto cleanup;
+    if (FAILED(WindowsCreateStringReference(class_name, wcslen(class_name), &header, &class_id))) goto cleanup;
+    if (FAILED(RoGetActivationFactory(class_id, &IID_IJsonValueStatics, (void **)&statics))) goto cleanup;
+    if (!(length = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, (const char *)buffer, size, NULL, 0))) goto cleanup;
+    if (!(wide = calloc(length + 1, sizeof(*wide)))) goto cleanup;
+    if (!MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, (const char *)buffer, size, wide, length)) goto cleanup;
+    if (FAILED(WindowsCreateString(wide, length, &text))) goto cleanup;
+    /* Do not use parse_json: its TRACE includes the complete response body. */
+    if (FAILED(IJsonValueStatics_Parse(statics, text, &value))) goto cleanup;
+    if (FAILED(IJsonValue_GetObject(value, &object))) goto cleanup;
+    if (SUCCEEDED(get_json_number(object, L"XErr", &number)) &&
+        number >= 0 && number <= UINT32_MAX && number == (DWORD)number)
+    {
+        *code = (DWORD)number;
+        valid = TRUE;
+    }
+cleanup:
+    if (object) IJsonObject_Release( object );
+    if (value) IJsonValue_Release( value );
+    if (statics) IJsonValueStatics_Release( statics );
+    if (text) WindowsDeleteString( text );
+    free( wide );
+    if (SUCCEEDED(com)) CoUninitialize();
+    return valid;
+}
