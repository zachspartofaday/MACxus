@@ -0,0 +1,27 @@
+//! One binary, two roles. The shipping macOS bundle copies `xodus-cli` to
+//! `xodus-service` byte for byte, so both share one code hash and one
+//! Keychain grant; the role comes from the executable's file name.
+
+use std::path::Path;
+
+/// True when this executable should run as the Xodus service.
+pub fn is_service(executable: Option<&Path>) -> bool {
+    executable
+        .and_then(Path::file_name)
+        .and_then(|name| name.to_str())
+        .is_some_and(|name| name == "xodus-service")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn role_follows_the_executable_file_name_only() {
+        assert!(is_service(Some(Path::new("/Applications/MACxus.app/Contents/Resources/backend/xodus-service"))));
+        assert!(!is_service(Some(Path::new("/Applications/MACxus.app/Contents/Resources/backend/xodus-cli"))));
+        assert!(!is_service(Some(Path::new("/tmp/xodus-service-old"))));
+        assert!(!is_service(Some(Path::new("/tmp/xodus-service/xodus-cli"))));
+        assert!(!is_service(None));
+    }
+}
