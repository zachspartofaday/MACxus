@@ -0,0 +1,244 @@
+//! One keychain item for every Xodus secret.
+//!
+//! macOS binds Keychain access grants to the exact code hash of the binary
+//! that asks (there is no Team ID in a self-signed MACxus build), and it keeps
+//! one grant per item. Six items read by two binaries meant up to twelve
+//! "Always Allow" dialogs per backend build. Keeping all secrets in one item
+//! reduces that to one grant per binary.
+//!
+//! The bundle is a JSON object `{ "<service>\u{0}<user>": "<base64 secret>" }`
+//! stored as the secret of one inner-store credential. Legacy per-user items
+//! are read once, copied into the bundle and deleted, so an existing sign-in
+//! survives the switch without a new login.
+
+use std::any::Any;
+use std::collections::{BTreeMap, HashMap};
+use std::sync::{Arc, Mutex};
+
+use base64::{Engine as _, engine::general_purpose::STANDARD};
+use keyring_core::api::{CredentialApi, CredentialStoreApi};
+use keyring_core::{Credential, CredentialPersistence, CredentialStore, Entry, Error, Result};
+
+type Bundle = BTreeMap<String, String>;
+
+/// The inner store and the one item that holds every secret.
+struct Shared {
+    inner: Arc<CredentialStore>,
+    service: String,
+    account: String,
+    /// Serializes read-modify-write cycles inside one process. Two backend
+    /// processes (xodus-cli and xodus-service) still race in theory; they
+    /// only write during sign-in and token refresh.
+    lock: Mutex<()>,
+}
+
+impl Shared {
+    fn item(&self) -> Result<Entry> {
+        self.inner.build(&self.service, &self.account, None)
+    }
+
+    fn load(&self) -> Result<Bundle> {
+        match self.item()?.get_secret() {
+            Ok(bytes) => serde_json::from_slice::<Bundle>(&bytes)
+                .map_err(|e| Error::BadDataFormat(bytes.clone(), Box::new(e))),
+            Err(Error::NoEntry) => Ok(Bundle::new()),
+            Err(e) => Err(e),
+        }
+    }
+
+    fn save(&self, bundle: &Bundle) -> Result<()> {
+        if bundle.is_empty() {
+            return match self.item()?.delete_credential() {
+                Ok(()) | Err(Error::NoEntry) => Ok(()),
+                Err(e) => Err(e),
+            };
+        }
+        let bytes = serde_json::to_vec(bundle).map_err(|e| Error::PlatformFailure(Box::new(e)))?;
+        self.item()?.set_secret(&bytes)
+    }
+}
+
+pub struct BundledStore {
+    shared: Arc<Shared>,
+}
+
+impl std::fmt::Debug for BundledStore {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "BundledStore({}/{} over {})", self.shared.service, self.shared.account, self.shared.inner.vendor())
+    }
+}
+
+impl BundledStore {
+    pub fn new(inner: Arc<CredentialStore>, service: &str, account: &str) -> Arc<Self> {
+        let shared = Shared { inner, service: service.to_owned(), account: account.to_owned(), lock: Mutex::new(()) };
+        Arc::new(Self { shared: Arc::new(shared) })
+    }
+}
+
+impl CredentialStoreApi for BundledStore {
+    fn vendor(&self) -> String {
+        format!("MACxus single-item bundle over {}", self.shared.inner.vendor())
+    }
+
+    fn id(&self) -> String {
+        format!("bundle:{}/{}:{}", self.shared.service, self.shared.account, self.shared.inner.id())
+    }
+
+    fn build(&self, service: &str, user: &str, _modifiers: Option<&HashMap<&str, &str>>) -> Result<Entry> {
+        if service == self.shared.service && user == self.shared.account {
+            return Err(Error::Invalid("user".into(), "reserved for the secret bundle itself".into()));
+        }
+        let credential = BundledCredential { shared: self.shared.clone(), service: service.to_owned(), user: user.to_owned() };
+        Ok(Entry::new_with_credential(Arc::new(credential)))
+    }
+
+    fn as_any(&self) -> &dyn Any {
+        self
+    }
+
+    fn persistence(&self) -> CredentialPersistence {
+        self.shared.inner.persistence()
+    }
+}
+
+struct BundledCredential {
+    shared: Arc<Shared>,
+    service: String,
+    user: String,
+}
+
+impl std::fmt::Debug for BundledCredential {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "BundledCredential({}/{})", self.service, self.user)
+    }
+}
+
+impl BundledCredential {
+    fn key(&self) -> String {
+        format!("{}\u{0}{}", self.service, self.user)
+    }
+
+    fn legacy(&self) -> Result<Entry> {
+        self.shared.inner.build(&self.service, &self.user, None)
+    }
+
+    /// A per-user item written by an older backend: read, copy into the
+    /// bundle, delete. A legacy item that cannot be deleted is harmless; the
+    /// bundle wins on every later read.
+    fn migrate_legacy(&self, bundle: &mut Bundle) -> Result<Option<Vec<u8>>> {
+        let legacy = self.legacy()?;
+        let secret = match legacy.get_secret() {
+            Ok(bytes) => bytes,
+            Err(Error::NoEntry) => return Ok(None),
+            Err(e) => return Err(e),
+        };
+        bundle.insert(self.key(), STANDARD.encode(&secret));
+        self.shared.save(bundle)?;
+        let _ = legacy.delete_credential();
+        Ok(Some(secret))
+    }
+}
+
+impl CredentialApi for BundledCredential {
+    fn set_secret(&self, secret: &[u8]) -> Result<()> {
+        let _guard = self.shared.lock.lock().expect("bundle lock poisoned");
+        let mut bundle = self.shared.load()?;
+        bundle.insert(self.key(), STANDARD.encode(secret));
+        self.shared.save(&bundle)
+    }
+
+    fn get_secret(&self) -> Result<Vec<u8>> {
+        let _guard = self.shared.lock.lock().expect("bundle lock poisoned");
+        let mut bundle = self.shared.load()?;
+        match bundle.get(&self.key()) {
+            Some(encoded) => STANDARD.decode(encoded).map_err(|_| Error::BadEncoding(encoded.clone().into_bytes())),
+            None => self.migrate_legacy(&mut bundle)?.ok_or(Error::NoEntry),
+        }
+    }
+
+    fn delete_credential(&self) -> Result<()> {
+        let _guard = self.shared.lock.lock().expect("bundle lock poisoned");
+        let mut bundle = self.shared.load()?;
+        if bundle.remove(&self.key()).is_some() {
+            return self.shared.save(&bundle);
+        }
+        // Not in the bundle: clear a legacy item so a removed sign-in does
+        // not resurface through migration. NoEntry propagates as upstream expects.
+        self.legacy()?.delete_credential()
+    }
+
+    fn get_credential(&self) -> Result<Option<Arc<Credential>>> {
+        self.get_secret().map(|_| None)
+    }
+
+    fn get_specifiers(&self) -> Option<(String, String)> {
+        Some((self.service.clone(), self.user.clone()))
+    }
+
+    fn as_any(&self) -> &dyn Any {
+        self
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use keyring_core::api::CredentialStoreApi;
+    use std::sync::Arc;
+
+    fn bundle() -> (Arc<keyring_core::sample::Store>, Arc<BundledStore>) {
+        let inner = keyring_core::sample::Store::new().unwrap();
+        let store = BundledStore::new(inner.clone(), "Xodus Service", "secrets");
+        (inner, store)
+    }
+
+    #[test]
+    fn credential_bundle_round_trips_several_users_through_one_inner_item() {
+        let (inner, store) = bundle();
+        let a = store.build("Xodus Service", "user-tokens", None).unwrap();
+        let b = store.build("Xodus Service", "device-tokens", None).unwrap();
+        a.set_secret(b"alpha").unwrap();
+        b.set_secret(b"beta\0\xff").unwrap();
+        assert_eq!(a.get_secret().unwrap(), b"alpha");
+        assert_eq!(b.get_secret().unwrap(), b"beta\0\xff");
+        // Only the bundle item exists in the inner store.
+        let item = inner.build("Xodus Service", "secrets", None).unwrap();
+        assert!(item.get_secret().is_ok());
+        assert!(matches!(inner.build("Xodus Service", "user-tokens", None).unwrap().get_secret(), Err(keyring_core::Error::NoEntry)));
+    }
+
+    #[test]
+    fn credential_bundle_reports_no_entry_for_unknown_and_deleted_users() {
+        let (_inner, store) = bundle();
+        let entry = store.build("Xodus Service", "user-DA", None).unwrap();
+        assert!(matches!(entry.get_secret(), Err(keyring_core::Error::NoEntry)));
+        assert!(matches!(entry.delete_credential(), Err(keyring_core::Error::NoEntry)));
+        entry.set_secret(b"x").unwrap();
+        entry.delete_credential().unwrap();
+        assert!(matches!(entry.get_secret(), Err(keyring_core::Error::NoEntry)));
+    }
+
+    #[test]
+    fn credential_bundle_migrates_legacy_per_user_items_on_first_read() {
+        let (inner, store) = bundle();
+        inner.build("Xodus Service", "user-tokens", None).unwrap().set_secret(b"legacy").unwrap();
+        let entry = store.build("Xodus Service", "user-tokens", None).unwrap();
+        assert_eq!(entry.get_secret().unwrap(), b"legacy");
+        // Migrated into the bundle and removed from the legacy item.
+        assert!(matches!(inner.build("Xodus Service", "user-tokens", None).unwrap().get_secret(), Err(keyring_core::Error::NoEntry)));
+        assert_eq!(entry.get_secret().unwrap(), b"legacy");
+    }
+
+    #[test]
+    fn credential_bundle_keeps_other_users_when_one_is_rewritten_or_deleted() {
+        let (_inner, store) = bundle();
+        let a = store.build("Xodus Service", "user-tokens", None).unwrap();
+        let b = store.build("Xodus Service", "user-session", None).unwrap();
+        a.set_secret(b"one").unwrap();
+        b.set_secret(b"two").unwrap();
+        a.set_secret(b"one-v2").unwrap();
+        b.delete_credential().unwrap();
+        assert_eq!(a.get_secret().unwrap(), b"one-v2");
+        assert!(matches!(b.get_secret(), Err(keyring_core::Error::NoEntry)));
+    }
+}
