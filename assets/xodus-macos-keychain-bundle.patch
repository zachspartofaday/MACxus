--- /dev/null
+++ b/crates/xodus-service/src/lib.rs
@@ -0,0 +1,104 @@
+//! xodus-service as a library, so `xodus-cli` can host it in the same
+//! binary. macOS ties Keychain grants to the binary's code hash and resets an
+//! item's partition list on every update by a non-Team-ID binary; two
+//! binaries writing the same item prompt each other forever. One binary, one
+//! grant (see MACxus docs/DISCOVERIES.md, 18).
+
+use std::fs::Permissions;
+use std::os::unix::fs::PermissionsExt;
+use std::sync::Arc;
+
+use tokio::net::UnixListener;
+use tokio_util::sync::CancellationToken;
+use tracing_subscriber::Layer;
+use tracing_subscriber::layer::SubscriberExt;
+use tracing_subscriber::util::SubscriberInitExt;
+use xodus::tokens::TokenManager;
+
+mod connection;
+mod simple_context;
+mod store_license;
+mod store_updates;
+mod utils;
+
+const XML_MAGIC: u32 = 0x58445358;
+const PROTO_MAGIC: u32 = 0x58445350;
+
+/// Run the Xodus service until Ctrl-C. Exits the process on credential
+/// failures, as the standalone binary always did.
+pub async fn serve() {
+    let filter = tracing_subscriber::EnvFilter::from_env("XODUS_LOG");
+    let registry =
+        tracing_subscriber::registry().with(tracing_subscriber::fmt::layer().with_filter(filter));
+
+    #[cfg(feature = "tokio_console")]
+    {
+        use tracing::level_filters::LevelFilter;
+        use tracing_subscriber::filter::Targets;
+
+        let console_filter = Targets::new()
+            .with_target("tokio", LevelFilter::TRACE)
+            .with_target("runtime", LevelFilter::TRACE);
+        let console_layer = console_subscriber::spawn().with_filter(console_filter);
+        registry.with(console_layer).init();
+    }
+    #[cfg(not(feature = "tokio_console"))]
+    {
+        registry.init();
+    }
+
+    if let Err(error) = xodus::secrets::init_secrets() {
+        xodus::tokens::store::TokenStoreError::from(error).report();
+        std::process::exit(1);
+    }
+    let tokens = Arc::new(TokenManager::with_keychain_and_memory());
+    if let Err(error) =
+        xodus::tokens::device::ensure_device_credentials(&reqwest::Client::new(), &tokens).await
+    {
+        error.report();
+        std::process::exit(1);
+    }
+    let xodus::models::secrets::Token::Legacy(device_token) = (match tokens.get_device_sts_token() {
+        Ok(token) => token,
+        Err(error) => {
+            error.report();
+            std::process::exit(1);
+        }
+    }) else {
+        xodus::tokens::store::TokenStoreError::DeviceAuthentication.report();
+        std::process::exit(1);
+    };
+
+    let runtime_dir = utils::get_runtime_dir();
+    let cancellation = CancellationToken::new();
+    let socket_path = format!("{runtime_dir}/xodus.sock");
+    let trigger = cancellation.clone();
+    tokio::spawn(async move {
+        tokio::signal::ctrl_c()
+            .await
+            .expect("Failure to handle ctrl_c");
+        trigger.cancel();
+    });
+    {
+        let listener = UnixListener::bind(&socket_path).expect("Unable to bind to socket");
+        let mode = 0o600;
+        let perms = Permissions::from_mode(mode);
+        _ = tokio::fs::set_permissions(&socket_path, perms).await;
+        loop {
+            let accept = tokio::select! {
+                r = listener.accept() => r,
+                _ = cancellation.cancelled() => break,
+            }
+            .expect("Failed to accept");
+
+            let token = cancellation.clone();
+            let device_token = device_token.clone();
+            let tokens = tokens.clone();
+            tokio::spawn(async move {
+                connection::router::route(accept.0, token, device_token, tokens).await
+            });
+        }
+    }
+
+    _ = tokio::fs::remove_file(socket_path).await;
+}
